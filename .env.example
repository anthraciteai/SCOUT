# ---- DSIP (DoD SBIR/STTR) public API ----
DSIP_BASE_URL=https://www.dodsbirsttr.mil/topics/api/public
# Browser-like UA is required, the API returns 403 without it.
DSIP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ---- Ollama ----
# Inside compose the ollama service is reachable at http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
# The model used by all agents. gpt-oss:20b is large (~14GB) - pull it once (see README).
OLLAMA_MODEL=gpt-oss:20b
# Fallback model to auto-use if OLLAMA_MODEL is not present (set empty to disable)
OLLAMA_FALLBACK_MODEL=llama3.1:8b
# Request timeout for LLM calls (seconds). 20b models on CPU are slow (~10 tok/s).
OLLAMA_TIMEOUT=1200

# ---- Storage ----
DATABASE_URL=sqlite:////data/sbir_scout.db
DATA_DIR=/data

# ---- Server ----
BACKEND_PORT=8000
# Port the web UI is served on (http://localhost:8080)
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Docling ----
# If true, resume/debrief text extraction uses Docling (heavier, better OCR).
# If false, uses a lightweight extractor (python-docx / pypdf).
USE_DOCLING=true

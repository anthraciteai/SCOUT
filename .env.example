# ---- DSIP (DoD SBIR/STTR) public API ----
DSIP_BASE_URL=https://www.dodsbirsttr.mil/topics/api/public
# Browser-like UA is required, the API returns 403 without it.
DSIP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ---- Ollama ----
# Backend uses host networking, so localhost is the laptop's snap Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Primary model. llama3.2:3b is already on this laptop; llama3.1:8b is optional.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
# Request timeout for LLM calls (seconds).
OLLAMA_TIMEOUT=600

# ---- Storage ----
DATABASE_URL=sqlite:////data/scout.db
DATA_DIR=/data

# ---- Server ----
BACKEND_PORT=8000
# Port the web UI is served on (http://localhost:8080)
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Docling ----
# If true, resume/debrief text extraction uses Docling (heavier, better OCR).
# If false, uses a lightweight extractor (python-docx / pypdf).
USE_DOCLING=true

# ---- Org vault / auth ----
# true = stub identity (auto Dev; switch Ken/Jake/Matt at /login).
AUTH_DISABLED=true
AUTH_SECRET=scout-dev-secret-change-me
DEFAULT_COMPANY=anthracite
VAULT_DIR=/data/vault
# Production overlay (docker-compose.prod.yml) sets STORAGE_ENDPOINT and Keycloak.
# STORAGE_ENDPOINT=
# KEYCLOAK_URL=
# KEYCLOAK_PUBLIC_URL=
# KEYCLOAK_REALM=scout
# KEYCLOAK_AUDIENCE=scout-frontend
